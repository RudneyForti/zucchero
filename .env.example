# API
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://confeitaria_app:confeitaria_app@localhost:5432/confeitaria
DATABASE_ADMIN_URL=postgres://confeitaria_admin:confeitaria_admin@localhost:5432/confeitaria
DATABASE_WORKER_URL=postgres://confeitaria_admin:confeitaria_admin@localhost:5432/confeitaria
REDIS_URL=redis://localhost:6379
AWS_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# Somente piloto local. A API recusa este provedor com NODE_ENV=production.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_PASSWORD_HASH=
LOCAL_AUTH_TOTP_SECRET=
# Use pelo menos 32 caracteres aleatórios; assina sessões locais e nunca vai ao navegador.
LOCAL_AUTH_SESSION_SECRET=
# Opcional no piloto: chave distinta, com 32+ caracteres, para cifrar os segredos MFA no banco.
# Quando vazia, a API deriva a proteção de LOCAL_AUTH_SESSION_SECRET.
LOCAL_MFA_ENCRYPTION_KEY=

# Google Maps Routes API. Mantenha a chave restrita ao servidor/API.
GOOGLE_MAPS_API_KEY=
# Opcional: segredo com 32+ caracteres para assinar cotações efêmeras de entrega.
# Quando vazio, a API usa LOCAL_AUTH_SESSION_SECRET.
DELIVERY_QUOTE_SECRET=

# Web (server-side)
API_INTERNAL_URL=http://localhost:3001/v1
DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
AUTH_REQUIRED=false
WEB_PUBLIC_URL=http://localhost:3000
